# ============================================================
# DivyaKosh / DAANDRISHTI - Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg-info/
dist/
build/
.eggs/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# API keys / credentials
*.pem
*.key
credentials.json
service-account*.json

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# -------------------------
# Logs
# -------------------------
logs/*.log
logs/*.txt

# Keep inference log out of Git
logs/inference.jsonl

# -------------------------
# Debug / Temporary Output
# -------------------------
debug/
tmp/
temp/
*.tmp

# -------------------------
# Model checkpoints
# -------------------------
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.keras

# -------------------------
# Generated model outputs
# -------------------------
models/*_history.json
models/*_results.json

# -------------------------
# Large generated datasets
# -------------------------
synthetic_dataset/
data2/
data/

# -------------------------
# Dataset archives
# -------------------------
*.zip
*.tar
*.tar.gz
*.7z

# -------------------------
# Generated audit outputs
# -------------------------
audit/*.csv
audit/*.json

# -------------------------
# Camera/debug images
# -------------------------
debug/live_roi/
debug/*.jpg
debug/*.jpeg
debug/*.png

# -------------------------
# OS files
# -------------------------
Thumbs.db
Desktop.ini